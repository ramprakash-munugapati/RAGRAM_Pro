# RAGRAM_Pro local environment — COPY TO `.env` AND EDIT.
# (`.env` is gitignored; this template is committed as `.env.example`.)
#
# Loaded automatically by: `python app.py` and `examples/fastapi_app.py`
# (via `envfile.load_env()`). Real shell/CI variables always win over file
# values. Blank values are treated as unset.

# ---------------------------------------------------------------- storage ---
# PostgreSQL DSN — required when RAGRAM_STORAGE=postgres
DATABASE_URL=postgresql://user:password@localhost:5432/ragram

# ------------------------------------------------------------------ demo ----
# Pipeline defaults for `python app.py` and the FastAPI example.
# Command-line flags still override these when passed explicitly.
RAGRAM_STORAGE=memory            # memory | postgres
RAGRAM_EMBEDDER=hashing          # hashing | sbert
RAGRAM_EMBEDDER_DIMENSIONS=256
RAGRAM_EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAGRAM_RERANKER=noop             # noop | hf | cohere
RAGRAM_RERANKER_MODEL=BAAI/bge-reranker-base
RAGRAM_FUSION=rrf                # rrf | normalized
RAGRAM_RRF_K=60
RAGRAM_CANDIDATE_LIMIT=25
RAGRAM_THRESHOLD=0.3
RAGRAM_TOP_N=4

# -------------------------------------------------------------- reranking ---
COHERE_API_KEY=
COHERE_MODEL=rerank-v3.5

# ------------------------------------------------------------- generation ---
# Used by integrations/generation.py backends (see README "Integrations").
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # e.g. point at an Ollama/OpenAI-compatible server
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ----------------------------------------------------------- fastapi demo ---
API_HOST=127.0.0.1
API_PORT=8000

# Optional: point load_env() at a custom file (overrides auto-discovery)
# RAGRAM_ENV_FILE=/path/to/.env
